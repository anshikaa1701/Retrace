# =============================================================================
# RETRACE ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# =============================================================================

# Application Server Port (used in standalone production container; default 3000)
PORT=3000
NODE_ENV=production

# -----------------------------------------------------------------------------
# GOOGLE GEMINI AI ASSISTANT (SERVER-SIDE ONLY SECRET)
# -----------------------------------------------------------------------------
# Obtain your free API key at: https://aistudio.google.com/
# CRITICAL SECURITY NOTE:
# This key is only accessed on the secure server backend (/api/ai/chat).
# It is NEVER exposed to the frontend browser bundle.
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION (OPTIONAL)
# -----------------------------------------------------------------------------
# Public client configuration:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Private service-role key (server-only, bypasses RLS - never expose to browser):
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -----------------------------------------------------------------------------
# ELEVENLABS TEXT-TO-SPEECH (SERVER-SIDE ONLY SECRET)
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

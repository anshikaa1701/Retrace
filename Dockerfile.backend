# =============================================================================
# BACKEND DOCKERFILE - NODE.JS API & AI DIAGNOSTIC SERVICE
# =============================================================================
FROM node:22-alpine AS runner

WORKDIR /app

# Ensure curl / wget is available for health check
RUN apk add --no-cache wget

# Create non-root system user and group
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 retrace

# Environment defaults
ENV NODE_ENV=production
ENV PORT=3001
ENV HOST=0.0.0.0

# Copy application server and backend middleware
COPY --chown=retrace:nodejs server.js package.json ./
COPY --chown=retrace:nodejs src/server ./src/server

USER retrace

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3001/health || exit 1

CMD ["node", "server.js"]
